# --- Core ---
ENV=dev

# --- Postgres ---
POSTGRES_DB=parser
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django secret (replace in prod)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Django Admin (dev) ---
# Если задать username/password, backend при старте создаст/обновит суперпользователя.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Telegram ---
BOT_TOKEN=replace-me

# --- Internal URLs ---
BACKEND_BASE_URL=http://backend:8000

# Shared token for internal services (worker/bot/scheduler -> backend)
INTERNAL_API_TOKEN=dev-internal-token

# --- Streams (at-least-once) ---
# Redis Streams дают ack (XACK), pending backlog и корректное масштабирование consumer-ов.
REDIS_STREAM_CHECKS=stream:checks
REDIS_GROUP_CHECKS=workers
REDIS_STREAM_NOTIFY=stream:notify
REDIS_GROUP_NOTIFY=bot

# Через сколько миллисекунд считать pending-сообщение "зависшим" и подбирать его другим consumer'ом.
REDIS_CLAIM_MIN_IDLE_MS=60000

# Опционально: ограничение ретенции Streams (0/пусто = без ограничения).
# Важно: MAXLEN может приводить к потере сообщений при большом backlog, поэтому включайте осознанно.
REDIS_STREAM_MAXLEN_CHECKS=
REDIS_STREAM_MAXLEN_NOTIFY=

# --- Worker demo mode ---
# Пока нет парсинга источника, worker будет слать один фиксированный item для проверки дедупа.
WORKER_DEMO_MODE=1
WORKER_DEMO_EXTERNAL_ID=demo-a1

# --- Worker HTTP (source/backend) ---
# Proxy используется только для запросов к внешнему источнику, backend через proxy НЕ ходит.
WORKER_SOURCE_PROXY=
WORKER_SOURCE_TIMEOUT=10
WORKER_SOURCE_RETRIES=2
WORKER_SOURCE_BACKOFF_BASE=0.5
WORKER_SOURCE_BACKOFF_CAP=5

WORKER_API_TIMEOUT=10
WORKER_API_RETRIES=3
WORKER_API_BACKOFF_BASE=0.5
WORKER_API_BACKOFF_CAP=5

# --- Bot HTTP (backend) ---
BOT_API_TIMEOUT=10
BOT_API_RETRIES=3
BOT_API_BACKOFF_BASE=0.5
BOT_API_BACKOFF_CAP=5

# Опциональный proxy для httpx-запросов бота (вызовы backend из bot).
# Формат: http://user:pass@host:port
BOT_PROXY=
